{
  "include": [
    "app/**/*.php",
    "resources/views/**/*.blade.php",
    "resources/js/**/*.ts",
    "resources/js/**/*.tsx"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/storage/**",
    "**/bootstrap/cache/**",
    "**/public/build/**",
    "tests/**",
    "tools/i18n/fixtures/**",
    "resources/js/components/examples/**",
    "resources/js/wayfinder/**",
    "resources/js/lib/i18n.ts",
    "resources/js/types/**",
    "resources/js/actions/**",
    "resources/js/routes/**"
  ],
  "userFacingPhpSinks": [
    "view",
    "Inertia::render",
    "inertia",
    "Mail::send",
    "Mail::to",
    "Notification::send",
    "flash",
    "session()->flash",
    "back()->with",
    "redirect()->with"
  ],
  "userFacingPhpMethods": [
    "subject",
    "line",
    "greeting",
    "action",
    "salutation"
  ],
  "userFacingJsxAttrs": [
    "aria-label",
    "aria-description",
    "alt",
    "title",
    "placeholder",
    "label",
    "description"
  ],
  "userFacingJsObjectKeys": [
    "label",
    "title",
    "placeholder",
    "description",
    "heading",
    "cta",
    "subtitle",
    "tooltip",
    "helperText",
    "errorMessage"
  ],
  "userFacingJsHelpers": [
    "toast",
    "toast.success",
    "toast.error",
    "toast.warning",
    "showDialog",
    "confirm"
  ],
  "translationHelpers": [
    "t",
    "tChoice",
    "__",
    "trans",
    "trans_choice",
    "@lang"
  ],
  "allowList": [
    { "path": "*", "literal": "Tekitl", "note": "Brand name" }
  ]
}
